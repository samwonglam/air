<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>空氣的特性｜小五科學互動實驗館</title>
  <style>
    :root {
      --bg-cream: #f8fafc;
      --bg-dots: #e2e8f0;
      --paper: #ffffff;
      --primary-blue: #0284c7;
      --primary-light: #f0f9ff;
      --accent-coral: #f43f5e;
      --accent-coral-light: #fff1f2;
      --ink-dark: #0f172a;
      --ink-muted: #475569;
      --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      --radius-lg: 16px;
      --radius-md: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "PingFang HK", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
      background-color: var(--bg-cream);
      color: var(--ink-dark);
      line-height: 1.5;
      padding: 12px 10px 40px;
    }

    .notebook-shell {
      max-width: 1100px;
      margin: 0 auto;
      background: var(--paper);
      border: 2px solid #cbd5e1;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .top-bar {
      background: #1e293b;
      color: #fff;
      padding: 14px 20px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .title-text h1 { font-size: 1.35rem; font-weight: 700; color: #f8fafc; }
    .title-text p { font-size: 0.88rem; color: #94a3b8; font-weight: 400; }

    .reward-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #334155;
      border: 1px solid #475569;
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #fbbf24;
    }

    .mission-bar {
      margin: 12px 16px 0;
      padding: 12px 16px;
      background: var(--primary-light);
      border: 1.5px solid #bae6fd;
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .mission-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .mission-row-divider {
      border-top: 1px dashed #bae6fd;
      padding-top: 10px;
    }

    .step-tag {
      background: var(--primary-blue);
      color: #fff;
      font-weight: 600;
      font-size: 0.82rem;
      padding: 2px 10px;
      border-radius: 999px;
    }

    .btn-3d {
      appearance: none;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: var(--ink-dark);
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 7px 14px;
      border-radius: 8px;
      cursor: pointer;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      transition: all 0.1s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-3d:hover { background: #f1f5f9; }
    .btn-primary { background: var(--primary-blue); color: #fff; border-color: #0284c7; }
    .btn-primary:hover { background: #0369a1; }
    .btn-success { background: #10b981; color: #fff; border-color: #059669; }
    .btn-success:hover { background: #059669; }

    .preset-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .preset-chip {
      border: 1px solid #cbd5e1;
      background: #fff;
      color: var(--ink-dark);
      border-radius: 999px;
      padding: 5px 12px;
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
    }

    .preset-chip.active {
      background: #0284c7;
      color: #fff;
      border-color: #0284c7;
    }

    .workspace {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 16px;
      padding: 16px;
      align-items: start;
    }

    @media (max-width: 900px) {
      .workspace { grid-template-columns: 1fr; }
    }

    .canvas-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: var(--radius-lg);
      padding: 14px;
      box-shadow: var(--shadow-card);
    }

    .canvas-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
    }

    .step-progress {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--ink-dark);
    }

    .canvas-container {
      position: relative;
      width: 100%;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      overflow: hidden;
    }

    canvas { display: block; width: 100%; height: auto; }

    .control-panel-box {
      margin-top: 12px;
      background: #f1f5f9;
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .slider-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.88rem;
      font-weight: 600;
    }

    .slider-row input[type="range"] {
      flex: 1;
      accent-color: var(--primary-blue);
      cursor: pointer;
    }

    /* 右欄：POE 探究面板 */
    .side-panel {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .poe-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-card);
    }

    .poe-section {
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid #f1f5f9;
    }

    .poe-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--primary-blue);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .poe-desc {
      font-size: 0.9rem;
      color: var(--ink-dark);
      font-weight: 500;
      margin-bottom: 8px;
    }

    .options-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .option-btn {
      width: 100%;
      text-align: left;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--ink-dark);
      cursor: pointer;
      transition: all 0.1s;
    }

    .option-btn:hover { background: #f1f5f9; }
    .option-btn.selected {
      background: #e0f2fe;
      border-color: #0284c7;
      color: #0369a1;
      font-weight: 600;
    }
    .option-btn.wrong {
      background: #ffe4e6;
      border-color: #f43f5e;
      color: #be123c;
    }

    /* 免打字科學句子拼圖槽 */
    .puzzle-box {
      background: #fdf2f8;
      border: 1.5px dashed #f472b6;
      border-radius: 10px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .puzzle-dropzone {
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 8px;
      min-height: 38px;
      font-size: 0.88rem;
      font-weight: 600;
      color: #db2777;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }

    .word-chips-pool {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .word-chip {
      background: #fff;
      border: 1px solid #f472b6;
      color: #be185d;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }
    .word-chip:hover { background: #fce7f3; }

    .feedback-box {
      margin-top: 10px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 10px;
      font-size: 0.88rem;
      font-weight: 500;
    }

    /* 獎勵彈窗 */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 16px;
    }
    .modal-backdrop.show { display: flex; }

    .modal-card {
      background: #fff;
      border-radius: 20px;
      max-width: 440px;
      width: 100%;
      padding: 24px;
      text-align: center;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>
  <div class="notebook-shell">
    <header class="top-bar">
      <div class="title-text">
        <h1>空氣的特性｜小五科學互動實驗館</h1>
        <p>依循「先預測 ➔ 後觀察 ➔ 作解釋」POE 探究法</p>
      </div>
      <div class="reward-badge">
        <span>⭐ 實驗通關：<strong id="completedCount">0</strong> / 6 關</span>
      </div>
    </header>

    <section class="mission-bar">
      <div class="mission-row">
        <span class="step-tag">選擇實驗課題</span>
        <div class="preset-group" id="labButtons">
          <button type="button" class="preset-chip active" data-lab="cup">1. 倒轉杯子壓入水</button>
          <button type="button" class="preset-chip" data-lab="ball">2. 排球與空氣重量</button>
          <button type="button" class="preset-chip" data-lab="juice">3. 飲品盒與大氣壓強</button>
          <button type="button" class="preset-chip" data-lab="suction">4. 吸盤掛鈎原理</button>
          <button type="button" class="preset-chip" data-lab="temp">5. 空氣熱脹冷縮</button>
          <button type="button" class="preset-chip" data-lab="wind">6. 日間海風的形成</button>
        </div>
      </div>
    </section>

    <main class="workspace">
      <section class="canvas-card">
        <div class="canvas-header">
          <div class="step-progress" id="expTitleBadge">實驗 1：倒轉杯子壓入水中</div>
        </div>
        <div class="canvas-container">
          <canvas id="scienceCanvas" width="560" height="380"></canvas>
        </div>
        <div class="control-panel-box" id="controlPanelBox">
          <!-- 動態滑桿控制區 -->
        </div>
      </section>

      <aside class="side-panel">
        <div class="poe-card">
          <!-- POE 階段 1: 預測 -->
          <div class="poe-section" id="poePredictSection">
            <div class="poe-title">📌 階段一：預測 (Predict)</div>
            <div class="poe-desc" id="predictQuestionText">動手實驗前，你認為會發生甚麼事？</div>
            <div class="options-list" id="predictOptionsList"></div>
            <button type="button" class="btn-3d btn-primary" id="submitPredictBtn" style="margin-top:8px; width:100%; justify-content:center;">確定預測並解鎖觀察</button>
          </div>

          <!-- POE 階段 2 & 3: 觀察與解釋 -->
          <div class="poe-section" id="poeExplainSection" style="opacity:0.4; pointer-events:none;">
            <div class="poe-title">🔍 階段二與三：觀察與解釋 (Observe & Explain)</div>
            <div class="poe-desc" id="explainPromptText">請透過左側實驗動畫觀察，並完成下方科學結論：</div>
            
            <div class="puzzle-box">
              <span style="font-size:0.82rem; font-weight:600; color:#be185d;">🧩 請點選詞語填入下方空白處完成科學解釋：</span>
              <div class="puzzle-dropzone" id="puzzleDropzone">（點擊下方詞語填入）</div>
              <div class="word-chips-pool" id="wordChipsPool"></div>
            </div>

            <div style="display:flex; gap:8px; margin-top:10px;">
              <button type="button" class="btn-3d btn-success" id="submitExplainBtn" style="flex:1; justify-content:center;">提交科學解釋</button>
              <button type="button" class="btn-3d" id="resetStepBtn">重設</button>
            </div>
          </div>

          <div class="feedback-box" id="feedbackBox">
            💡 <strong>提示：</strong>請先完成階段一的「預測」，才能解鎖下方實驗觀察與解釋！
          </div>
        </div>
      </aside>
    </main>
  </div>

  <!-- 獎勵卡彈窗 -->
  <div class="modal-backdrop" id="rewardModal">
    <div class="modal-card">
      <h2 style="color:#0284c7; margin-bottom:8px;">🎉 太棒了！全部實驗通關！</h2>
      <p style="font-size:0.95rem; color:#475569; margin-bottom:16px;">你已經完全掌握了小五科學「空氣的特性」所有核心知識！</p>
      <div style="background:#f0f9ff; border:1px solid #bae6fd; padding:16px; border-radius:12px; margin-bottom:16px; font-weight:600; color:#0369a1;">
        🏅 獲得：「小五空氣科學探究達人」榮譽證書！
      </div>
      <button type="button" class="btn-3d btn-primary" id="closeModalBtn" style="width:100%; justify-content:center;">再玩一次</button>
    </div>
  </div>

  <script>
    (function(){
      const canvas = document.getElementById("scienceCanvas");
      const ctx = canvas.getContext("2d");

      // 6大實驗單元資料
      const LABS = [
        {
          id: "cup",
          title: "實驗 1：倒轉杯子壓入水中",
          predictQ: "把杯子垂直壓入水底，杯底的紙巾會濕嗎？",
          predictOpts: ["A. 不會濕，因為杯內空氣佔有空間，水進不去", "B. 會濕，因為水能穿透空氣", "C. 紙巾會直接溶化在水中"],
          correctPredict: 0,
          puzzleTemplate: "杯內的空氣 [A] 空間，所以水 [B] 進入杯底。",
          chips: ["佔有", "不佔有", "能", "不能"],
          correctChips: ["佔有", "不能"],
          hint: "觀察左側杯底，紫色空氣粒子擋住了水！"
        },
        {
          id: "ball",
          title: "實驗 2：排球與空氣重量",
          predictQ: "把右邊充氣排球的氣放掉後，電子磅的讀數會怎樣？",
          predictOpts: ["A. 兩邊一樣重", "B. 左邊（有氣）比右邊重", "C. 右邊（洩氣）變重"],
          correctPredict: 1,
          puzzleTemplate: "充滿氣的排球比洩氣的排球重，證明空氣 [A]。 ",
          chips: ["有重量", "沒有重量", "是真空的"],
          correctChips: ["有重量"],
          hint: "空氣雖然看不見，但它是有質量的！"
        },
        {
          id: "juice",
          title: "實驗 3：飲品盒與大氣壓強",
          predictQ: "用力吸走紙包飲品盒內的空氣後，盒子會怎樣？",
          predictOpts: ["A. 盒外大氣壓強大於盒內，把盒子壓扁", "B. 盒子脹得更大", "C. 完全沒有變化"],
          correctPredict: 0,
          puzzleTemplate: "吸走空氣後，盒內空氣減少，盒外 [A] 把盒子 [B]。 ",
          chips: ["大氣壓強", "沒有壓強", "壓扁", "撐大"],
          correctChips: ["大氣壓強", "壓扁"],
          hint: "留意畫布中藍色箭頭（盒外氣壓）比紅色箭頭大！"
        },
        {
          id: "suction",
          title: "實驗 4：吸盤掛鈎原理",
          predictQ: "把吸盤內的空氣擠出後，吸盤為甚麼能貼在牆上？",
          predictOpts: ["A. 吸盤有強力膠水", "B. 外面的大氣壓強把吸盤緊緊壓在牆上", "C. 牆壁有磁性"],
          correctPredict: 1,
          puzzleTemplate: "擠出吸盤空氣後，外面的 [A] 把吸盤緊緊 [B] 在牆上。",
          chips: ["大氣壓強", "空氣重量", "壓", "推"],
          correctChips: ["大氣壓強", "壓"],
          hint: "這和紙包飲品盒被壓扁的原理完全一樣！"
        },
        {
          id: "temp",
          title: "實驗 5：空氣熱脹冷縮",
          predictQ: "把套有氣球的膠樽放進熱水中，氣球會怎樣？",
          predictOpts: ["A. 氣球會發脹，因為空氣受熱膨脹", "B. 氣球會縮小", "C. 完全沒改變"],
          correctPredict: 0,
          puzzleTemplate: "空氣受熱會 [A]，遇冷會 [B]。",
          chips: ["膨脹", "收縮", "消失", "不動"],
          correctChips: ["膨脹", "收縮"],
          hint: "調整下方溫度滑桿，觀察熱水讓粒子跑得更快更遠！"
        },
        {
          id: "wind",
          title: "實驗 6：日間海風的形成",
          predictQ: "日間在太陽照射下，陸地與海洋的空氣流動會形成甚麼？",
          predictOpts: ["A. 形成海風（冷空氣由海洋吹向陸地）", "B. 形成陸風（由陸地吹向海洋）", "C. 完全沒有風"],
          correctPredict: 0,
          puzzleTemplate: "日間陸地空氣受熱 [A] 上昇，海洋較冷的空氣 [B] 補充，形成海風。",
          chips: ["膨脹", "收縮", "流向陸地", "流向海洋"],
          correctChips: ["膨脹", "流向陸地"],
          hint: "熱空氣向上走，海面冷空氣過來補位！"
        }
      ];

      let currentLabIdx = 0;
      let completedLabs = new Set();
      let stepState = 1; // 1: 預測階段, 2: 觀察與 解釋階段, 3: 本關完成
      let selectedPredictOpt = null;
      let userPuzzleChoices = [];

      // 各實驗互動參數 (Slider)
      let sliderVal = 50; // 0 ~ 100

      const labButtons = document.querySelectorAll(".preset-chip[data-lab]");
      const expTitleBadge = document.getElementById("expTitleBadge");
      const controlPanelBox = document.getElementById("controlPanelBox");
      const predictQuestionText = document.getElementById("predictQuestionText");
      const predictOptionsList = document.getElementById("predictOptionsList");
      const submitPredictBtn = document.getElementById("submitPredictBtn");
      const poeExplainSection = document.getElementById("poeExplainSection");
      const explainPromptText = document.getElementById("explainPromptText");
      const puzzleDropzone = document.getElementById("puzzleDropzone");
      const wordChipsPool = document.getElementById("wordChipsPool");
      const submitExplainBtn = document.getElementById("submitExplainBtn");
      const resetStepBtn = document.getElementById("resetStepBtn");
      const feedbackBox = document.getElementById("feedbackBox");
      const completedCountEl = document.getElementById("completedCount");
      const rewardModal = document.getElementById("rewardModal");
      const closeModalBtn = document.getElementById("closeModalBtn");

      function getLab() { return LABS[currentLabIdx]; }

      function initLabUI() {
        stepState = 1;
        selectedPredictOpt = null;
        userPuzzleChoices = [];
        sliderVal = 50;
        const lab = getLab();

        expTitleBadge.textContent = lab.title;
        predictQuestionText.textContent = lab.predictQ;

        // 渲染預測選項
        predictOptionsList.innerHTML = "";
        lab.predictOpts.forEach((opt, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "option-btn";
          btn.textContent = opt;
          btn.addEventListener("click", () => {
            selectedPredictOpt = idx;
            document.querySelectorAll("#predictOptionsList .option-btn").forEach((b, i) => {
              b.classList.toggle("selected", i === idx);
            });
          });
          predictOptionsList.appendChild(btn);
        });

        submitPredictBtn.disabled = false;
        poeExplainSection.style.opacity = "0.4";
        poeExplainSection.style.pointerEvents = "none";

        // 渲染控制滑桿
        renderControlPanel();
        renderPuzzleUI();

        feedbackBox.innerHTML = `💡 <strong>提示：</strong>請先選定你的「預測」，然後點擊確定按鈕解鎖實驗動畫！`;
      }

      function renderControlPanel() {
        controlPanelBox.innerHTML = "";
        const lab = getLab();

        if (lab.id === "cup") {
          controlPanelBox.innerHTML = `
            <div class="slider-row">
              <span>杯子下壓深度：</span>
              <input type="range" id="expSlider" min="0" max="100" value="${sliderVal}">
              <span id="sliderValTxt">${sliderVal}%</span>
            </div>`;
        } else if (lab.id === "ball") {
          controlPanelBox.innerHTML = `
            <div class="slider-row">
              <span>右邊排球狀態：</span>
              <input type="range" id="expSlider" min="0" max="100" value="${sliderVal}">
              <span id="sliderValTxt">${sliderVal > 50 ? '充滿氣' : '已放氣'}</span>
            </div>`;
        } else if (lab.id === "juice" || lab.id === "suction") {
          controlPanelBox.innerHTML = `
            <div class="slider-row">
              <span>大氣壓強（外大內小拉力）：</span>
              <input type="range" id="expSlider" min="10" max="100" value="${sliderVal}">
              <span id="sliderValTxt">${sliderVal} 級</span>
            </div>`;
        } else if (lab.id === "temp") {
          controlPanelBox.innerHTML = `
            <div class="slider-row">
              <span>水溫調節（0°C 冰水 ⟷ 85°C 熱水）：</span>
              <input type="range" id="expSlider" min="0" max="100" value="${sliderVal}">
              <span id="sliderValTxt">${Math.round(sliderVal * 0.85)}°C</span>
            </div>`;
        } else if (lab.id === "wind") {
          controlPanelBox.innerHTML = `
            <div class="slider-row">
              <span>日間太陽照射強度：</span>
              <input type="range" id="expSlider" min="10" max="100" value="${sliderVal}">
              <span id="sliderValTxt">${sliderVal}% 強度</span>
            </div>`;
        }

        const sl = document.getElementById("expSlider");
        if (sl) {
          sl.addEventListener("input", (e) => {
            sliderVal = parseInt(e.target.value, 10);
            const txt = document.getElementById("sliderValTxt");
            if (txt) {
              if (lab.id === "ball") txt.textContent = sliderVal > 50 ? '充滿氣' : '已放氣';
              else if (lab.id === "temp") txt.textContent = `${Math.round(sliderVal * 0.85)}°C`;
              else if (lab.id === "juice" || lab.id === "suction") txt.textContent = `${sliderVal} 級`;
              else txt.textContent = `${sliderVal}%`;
            }
          });
        }
      }

      function renderPuzzleUI() {
        const lab = getLab();
        explainPromptText.textContent = `請根據實驗觀察填空：${lab.puzzleTemplate}`;
        updatePuzzleDropzone();

        wordChipsPool.innerHTML = "";
        lab.chips.forEach((word) => {
          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = "word-chip";
          chip.textContent = word;
          chip.addEventListener("click", () => {
            userPuzzleChoices.push(word);
            updatePuzzleDropzone();
          });
          wordChipsPool.appendChild(chip);
        });
      }

      function updatePuzzleDropzone() {
        const lab = getLab();
        let html = lab.puzzleTemplate;
        let cIdx = 0;
        html = html.replace(/\[[A-Z]\]/g, () => {
          const val = userPuzzleChoices[cIdx];
          const slotStr = val ? `<span style="background:#fce7f3; padding:2px 8px; border-radius:4px; border:1px solid #f472b6;">${val}</span>` : `<span style="color:#94a3b8;">(請點下方詞語)</span>`;
          cIdx++;
          return slotStr;
        });
        puzzleDropzone.innerHTML = html;
      }

      resetStepBtn.addEventListener("click", () => {
        userPuzzleChoices = [];
        updatePuzzleDropzone();
      });

      // 確定預測
      submitPredictBtn.addEventListener("click", () => {
        const lab = getLab();
        if (selectedPredictOpt === null) {
          alert("請先選擇一個預測答案！");
          return;
        }

        const isCorrectPredict = (selectedPredictOpt === lab.correctPredict);
        poeExplainSection.style.opacity = "1";
        poeExplainSection.style.pointerEvents = "auto";
        submitPredictBtn.disabled = true;

        feedbackBox.innerHTML = isCorrectPredict
          ? `✅ <strong>預測正確！</strong>現在請觀察左側實驗動畫，並完成下方的科學解釋拼圖。`
          : `⚠️ <strong>預測與實際科學原理有落差：</strong>沒關係！請透過左側實驗動畫認真觀察，找出真相。`;
      });

      // 提交解釋
      submitExplainBtn.addEventListener("click", () => {
        const lab = getLab();
        if (userPuzzleChoices.length < lab.correctChips.length) {
          alert("請先點選足夠的詞語完成句子填空！");
          return;
        }

        let isMatch = true;
        lab.correctChips.forEach((correctW, i) => {
          if (userPuzzleChoices[i] !== correctW) isMatch = false;
        });

        if (isMatch) {
          completedLabs.add(currentLabIdx);
          completedCountEl.textContent = completedLabs.size;
          feedbackBox.innerHTML = `🎉 <strong>恭喜通關！</strong> ${lab.hint}`;
          stepState = 3;

          if (completedLabs.size >= LABS.length) {
            setTimeout(() => rewardModal.classList.add("show"), 500);
          }
        } else {
          feedbackBox.innerHTML = `❌ <strong>解釋有誤：</strong>請再檢查一次詞語填空是否符合科學原理。`;
        }
      });

      closeModalBtn.addEventListener("click", () => {
        rewardModal.classList.remove("show");
        completedLabs.clear();
        completedCountEl.textContent = "0";
        initLabUI();
      });

      labButtons.forEach((btn, idx) => {
        btn.addEventListener("click", () => {
          currentLabIdx = idx;
          labButtons.forEach((b, i) => b.classList.toggle("active", i === idx));
          initLabUI();
        });
      });

      // ================= 畫布物理模擬渲染 =================
      function drawScene() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const lab = getLab();

        if (lab.id === "cup") drawCupScene();
        else if (lab.id === "ball") drawBallScene();
        else if (lab.id === "juice") drawJuiceScene();
        else if (lab.id === "suction") drawSuctionScene();
        else if (lab.id === "temp") drawTempScene();
        else if (lab.id === "wind") drawWindScene();

        requestAnimationFrame(drawScene);
      }

      // 動態壓強箭頭繪製函式（粗幼與長度隨壓強數值變化）
      function drawPressureArrow(x, y, length, thickness, color, label) {
        ctx.save();
        ctx.strokeStyle = color;
        ctx.fillStyle = color;
        ctx.lineWidth = thickness;
        ctx.lineCap = "round";

        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + length, y);
        ctx.stroke();

        // 箭頭
        ctx.beginPath();
        ctx.moveTo(x + length, y);
        ctx.lineTo(x + length - 10, y - 6);
        ctx.lineTo(x + length - 10, y + 6);
        ctx.closePath();
        ctx.fill();

        if (label) {
          ctx.font = "bold 11px sans-serif";
          ctx.fillText(label, x + length / 2 - 20, y - 8);
        }
        ctx.restore();
      }

      function drawCupScene() {
        // 水槽
        ctx.fillStyle = "#e0f2fe";
        ctx.fillRect(80, 160, 400, 180);
        ctx.strokeStyle = "#0284c7";
        ctx.lineWidth = 3;
        ctx.strokeRect(80, 120, 400, 220);

        // 杯子下壓位置隨 sliderVal 改變
        const depthY = 60 + (sliderVal / 100) * 110;
        const cupX = 220;
        const cupW = 120;
        const cupH = 130;

        // 杯底空氣區
        ctx.fillStyle = "#fff";
        ctx.fillRect(cupX, depthY, cupW, cupH - 20);

        // 紙巾
        ctx.fillStyle = "#fef08a";
        ctx.fillRect(cupX + 15, depthY + 6, cupW - 30, 18);
        ctx.fillStyle = "#854d0e";
        ctx.font = "bold 11px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("紙巾（不濕）", cupX + cupW / 2, depthY + 19);

        // 玻璃杯
        ctx.strokeStyle = "#334155";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(cupX, depthY + cupH);
        ctx.lineTo(cupX, depthY);
        ctx.lineTo(cupX + cupW, depthY);
        ctx.lineTo(cupX + cupW, depthY + cupH);
        ctx.stroke();

        // 空氣微粒
        ctx.fillStyle = "#0284c7";
        for (let i = 0; i < 20; i++) {
          ctx.beginPath();
          ctx.arc(cupX + 15 + (i * 9) % (cupW - 30), depthY + 35 + (i * 7) % (cupH - 45), 3.5, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 13px sans-serif";
        ctx.fillText("空氣佔有空間，水無法進入杯底！", 280, 355);
      }

      function drawBallScene() {
        const cx = 280;
        // 電子磅
        ctx.fillStyle = "#e2e8f0";
        ctx.fillRect(cx - 120, 260, 240, 60);
        ctx.strokeStyle = "#475569";
        ctx.lineWidth = 3;
        ctx.strokeRect(cx - 120, 260, 240, 60);

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 16px sans-serif";
        ctx.textAlign = "center";
        const weightVal = sliderVal > 50 ? "425.5 g" : "420.1 g";
        ctx.fillText(`液晶讀數：${weightVal}`, cx, 300);

        // 排球 (左邊充氣，右邊隨 slider 決定充氣或洩氣)
        // 左排球
        ctx.fillStyle = "#f59e0b";
        ctx.beginPath();
        ctx.arc(cx - 90, 170, 55, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.stroke();

        // 右排球
        const isInflated = sliderVal > 50;
        ctx.fillStyle = isInflated ? "#38bdf8" : "#94a3b8";
        ctx.beginPath();
        if (isInflated) {
          ctx.arc(cx + 90, 170, 55, 0, Math.PI * 2);
        } else {
          ctx.ellipse(cx + 90, 190, 50, 35, 0, 0, Math.PI * 2);
        }
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#fff";
        ctx.font = "bold 13px sans-serif";
        ctx.fillText("充氣排球", cx - 90, 175);
        ctx.fillText(isInflated ? "充氣排球" : "洩氣排球", cx + 90, isInflated ? 175 : 195);
      }

      function drawJuiceScene() {
        const cx = 280;
        const topY = 110;
        const botY = 300;
        const boxW = 100;
        const squeeze = Math.round((sliderVal / 100) * 25);

        // 紙盒飲品
        ctx.fillStyle = "#fde047";
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(cx - boxW/2 + squeeze, topY);
        ctx.lineTo(cx + boxW/2 - squeeze, topY);
        ctx.lineTo(cx + boxW/2, botY);
        ctx.lineTo(cx - boxW/2, botY);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // 飲管
        ctx.strokeStyle = "#e11d48";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(cx, topY);
        ctx.lineTo(cx, 50);
        ctx.lineTo(cx + 40, 35);
        ctx.stroke();

        // 動態大氣壓強箭頭 (藍色外大氣壓，紅色內氣壓)
        const outerPressureLen = sliderVal * 1.2;
        const innerPressureLen = (101 - sliderVal) * 0.8;

        drawPressureArrow(cx - 160, 200, outerPressureLen, 6, "#0284c7", "盒外大氣壓強");
        drawPressureArrow(cx + 160, 200, -outerPressureLen, 6, "#0284c7", "");

        drawPressureArrow(cx - 30, 200, innerPressureLen, 3, "#e11d48", "盒內氣壓");

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 13px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("盒外大氣壓強大於盒內，把飲品盒壓扁！", cx, 345);
      }

      function drawSuctionScene() {
        // 牆壁
        ctx.fillStyle = "#94a3b8";
        ctx.fillRect(100, 60, 40, 260);
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.strokeRect(100, 60, 40, 260);

        // 吸盤大小隨 slider 壓緊程度改變
        const cupDepth = Math.round(20 + (sliderVal / 100) * 35);
        ctx.fillStyle = "#ec4899";
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(140, 150);
        ctx.quadraticCurveTo(140 + cupDepth, 190, 140, 230);
        ctx.stroke();

        // 毛巾
        ctx.fillStyle = "#f43f5e";
        ctx.fillRect(160, 190, 30, 100);

        // 動態大氣壓強箭頭
        const pressureLen = sliderVal * 1.5;
        drawPressureArrow(220, 190, pressureLen, 5, "#0284c7", "大氣壓強緊壓吸盤");

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 13px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("擠出吸盤空氣後，大氣壓強把吸盤緊壓在牆上！", 280, 350);
      }

      function drawTempScene() {
        const cx = 280;
        // 玻璃樽
        ctx.fillStyle = "rgba(226, 232, 240, 0.6)";
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.fillRect(cx - 40, 140, 80, 160);
        ctx.strokeRect(cx - 40, 140, 80, 160);

        // 氣球 (隨溫度 sliderVal 膨脹或收縮)
        const balloonRadius = 25 + (sliderVal / 100) * 45;
        ctx.fillStyle = "#f43f5e";
        ctx.beginPath();
        ctx.arc(cx, 120 - balloonRadius/2, balloonRadius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#0f172a";
        ctx.lineWidth = 3;
        ctx.stroke();

        // 粒子運動速度隨溫度加快
        ctx.fillStyle = "#0284c7";
        const pCount = 15;
        for (let i = 0; i < pCount; i++) {
          const speed = sliderVal * 0.1;
          const px = cx - 30 + (i * 13 + Date.now() * speed * (i % 2 === 0 ? 0.02 : -0.01)) % 60;
          const py = 160 + (i * 11 + Date.now() * speed * 0.01) % 120;
          ctx.beginPath();
          ctx.arc(px, py, 4, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 13px sans-serif";
        ctx.textAlign = "center";
        const tempC = Math.round(sliderVal * 0.85);
        ctx.fillText(`水溫：${tempC}°C ➔ 空氣受熱 ${tempC > 40 ? '膨脹' : '收縮'}`, cx, 340);
      }

      function drawWindScene() {
        // 海洋 (左) 與 陸地 (右)
        ctx.fillStyle = "#38bdf8";
        ctx.fillRect(60, 200, 220, 120);
        ctx.fillStyle = "#fde047";
        ctx.fillRect(280, 200, 220, 120);

        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 14px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("海洋（較涼）", 170, 260);
        ctx.fillText("陸地（受熱）", 390, 260);

        // 太陽照射強度隨 slider 改變
        ctx.fillStyle = "#f97316";
        ctx.beginPath();
        ctx.arc(390, 80, 20 + (sliderVal/100)*15, 0, Math.PI * 2);
        ctx.fill();

        // 畫出風的流動箭頭
        ctx.strokeStyle = "#0284c7";
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(220, 170);
        ctx.lineTo(340, 170);
        ctx.stroke();

        // 箭頭頭部
        ctx.fillStyle = "#0284c7";
        ctx.beginPath();
        ctx.moveTo(340, 170);
        ctx.lineTo(330, 162);
        ctx.lineTo(330, 178);
        ctx.closePath();
        ctx.fill();

        ctx.font = "bold 13px sans-serif";
        ctx.fillText("海面冷空氣流向陸地（形成海風）", 280, 150);
        ctx.fillText("日間陸地空氣受熱上升，海洋冷空氣補充！", 280, 355);
      }

      // 啟動程式
      initLabUI();
      requestAnimationFrame(drawScene);
    })();
  </script>
</body>
</html>
