    .class-btn.selected {
      background: var(--book-blue);
      color: #ffffff;
      border-color: #124d6b;
    }

    .num-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      margin: 8px 0 14px;
    }

    .num-btn {
      padding: 7px 2px;
      font-size: 0.92rem;
      font-weight: 800;
      border: 1.5px solid #cbd5e1;
      background: #ffffff;
      color: #334155;
      border-radius: 6px;
      cursor: pointer;
    }

    .num-btn:hover {
      background: #f1f5f9;
    }

    .num-btn.selected {
      background: #d9386a;
      color: #ffffff;
      border-color: #a31d47;
    }

