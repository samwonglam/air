    .q-visual-box {
      background: #f8fbff;
      border: 1.5px solid #dbeafe;
      border-radius: 8px;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 教師後台表格樣式 */
    .teacher-table {
      width: 100%;
