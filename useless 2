          const optWrap = document.createElement("div");
          optWrap.style.display = "flex";
          optWrap.style.flexDirection = "column";
          optWrap.style.gap = "6px";

          q.shuffledOpts.forEach((opt, oIdx) => {
            const btn = document.createElement("button");
            btn.type = "button";
            const isSelected = challengeAnswers[q.qNum] === opt.id;
            btn.className = "choice-btn" + (isSelected ? " selected" : "");
            btn.style.padding = "7px 10px";
            btn.style.fontSize = "0.92rem";
            btn.textContent = `${letters[oIdx]}. ${opt.text}`;
