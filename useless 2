    .challenge-container {
      max-width: 960px;
      margin: 14px auto 0;
      padding: 0 16px;
      display: none;
    }

    .challenge-card {
      background: #ffffff;
      border: 2px solid #94b8d0;
      border-radius: 10px;
      padding: 18px;
    }

    .diff-badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.78rem;
      font-weight: 900;
      margin-right: 6px;
    }

    .diff-easy { background: #d8f3dc; color: #1b4332; }
    .diff-mid { background: #ffedd5; color: #9a3412; }
    .diff-hard { background: #ffe4e6; color: #9f1239; }

    .challenge-q-item {
      border: 1.5px solid #cbd5e1;
      background: #ffffff;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 12px;
      text-align: left;
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 14px;
      align-items: center;
