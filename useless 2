      submitChallengeBtn.addEventListener("click", () => {
        if (Object.keys(challengeAnswers).length < CHALLENGE_QUESTIONS.length) {
          topAlertText.textContent = `請先回答全部 ${CHALLENGE_QUESTIONS.length} 題，然後再按提交！`;
          topAlertBox.style.display = "block";
          window.scrollTo({ top: 0, behavior: "smooth" });
          return;
        }

        let correctCount = 0;
        const missedItems = [];

        CHALLENGE_QUESTIONS.forEach((q) => {
          const pickedId = challengeAnswers[q.qNum];
          const chosenOpt = q.options.find((o) => o.id === pickedId);
          if (chosenOpt && chosenOpt.correct) {
            correctCount++;
          } else {
            const rightOpt = q.options.find((o) => o.correct);
            missedItems.push({
              qNum: q.qNum,
              topicName: q.topicName,
              diagramKey: q.diagramKey,
              rightAnswer: rightOpt ? rightOpt.text : "",
              shortExplain: q.shortExplain
            });
          }
        });

        // 8 題滿分 100 分（每題 12.5 分，四捨五入至整數）
        const score = Math.round((correctCount / CHALLENGE_QUESTIONS.length) * 100);

