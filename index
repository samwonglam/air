        ctx.fillStyle = "#e0f2fe";
        ctx.fillRect(90, 190, 420, 190);
        ctx.strokeStyle = "#0284c7";
        ctx.lineWidth = 4;
        ctx.strokeRect(90, 150, 420, 230);

        const cupY = expActed ? 200 : 50;
        const cupX = 235;
        const cupW = 130;
        const cupH = 145;

        // 杯內空氣空間背景
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(cupX, cupY, cupW, cupH - 12);

        // 杯底乾紙巾
        ctx.fillStyle = "#fef08a";
        ctx.strokeStyle = "#ca8a04";
        ctx.lineWidth = 2;
        ctx.fillRect(cupX + 20, cupY + 6, cupW - 40, 22);
        ctx.strokeRect(cupX + 20, cupY + 6, cupW - 40, 22);
        ctx.fillStyle = "#854d0e";
        ctx.font = "bold 12px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("乾紙巾（不濕）", cupX + cupW / 2, cupY + 21);

        // 倒轉玻璃杯框
        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(cupX, cupY + cupH);
        ctx.lineTo(cupX, cupY);
        ctx.lineTo(cupX + cupW, cupY);
        ctx.lineTo(cupX + cupW, cupY + cupH);
        ctx.stroke();

        // 微觀空氣粒子（佔滿杯子空間）
        drawParticlesInBox(cupX + 6, cupY + 32, cupW - 12, cupH - 42, 26, "#9333ea");

        if (showMicroLens) {
          ctx.fillStyle = "#6b21a8";
          ctx.font = "900 14px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("🟣 空氣粒子佔滿杯內空間，水進不去！", 300, 398);
        }
      }

      // 場景 1B：天平氣球（空氣有重量）
      function drawBalloonBalanceScene() {
        const cx = 300;
        const baseY = 350;

        // 天平底座
        ctx.fillStyle = "#d97706";
        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(cx - 45, baseY);
        ctx.lineTo(cx + 45, baseY);
        ctx.lineTo(cx, 200);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // 橫桿傾斜角度（刺穿右氣球後，左邊有空氣較重下沉）
        const tilt = expActed ? -0.18 : 0;
        ctx.save();
        ctx.translate(cx, 200);
        ctx.rotate(tilt);

        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(-160, 0);
        ctx.lineTo(160, 0);
        ctx.stroke();

        // 左邊充氣氣球
        ctx.fillStyle = "rgba(244, 114, 182, 0.35)";
        ctx.strokeStyle = "#db2777";
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(-150, -65, 52, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        if (showMicroLens) {
          ctx.fillStyle = "#9333ea";
          for (let i = 0; i < 16; i++) {
            const ang = (i / 16) * Math.PI * 2 + animTick * 0.03;
            const r = (i % 3) * 14 + 8;
            ctx.beginPath();
            ctx.arc(-150 + Math.cos(ang) * r, -65 + Math.sin(ang) * r, 4.5, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        // 右邊氣球（未刺穿 vs 已刺穿洩氣）
        if (!expActed) {
          ctx.fillStyle = "rgba(56, 189, 248, 0.35)";
          ctx.strokeStyle = "#0284c7";
          ctx.beginPath();
          ctx.arc(150, -65, 52, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
          if (showMicroLens) {
            ctx.fillStyle = "#9333ea";
            for (let i = 0; i < 16; i++) {
              const ang = (i / 16) * Math.PI * 2 - animTick * 0.03;
              const r = (i % 3) * 14 + 8;
              ctx.beginPath();
              ctx.arc(150 + Math.cos(ang) * r, -65 + Math.sin(ang) * r, 4.5, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        } else {
          // 扁掉的氣球皮
          ctx.fillStyle = "#bae6fd";
          ctx.strokeStyle = "#0284c7";
          ctx.fillRect(130, -28, 40, 14);
          ctx.strokeRect(130, -28, 40, 14);
          ctx.fillStyle = "#be123c";
          ctx.font = "900 13px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("💥 空氣跑掉了（變輕）", 150, -45);
        }

        ctx.restore();

        if (expActed) {
          ctx.fillStyle = "#15803d";
          ctx.font = "900 15px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("⬇️ 左邊有空氣粒子所以較重下沉，證明「空氣有重量」！", cx, 392);
        }
      }

      // 場景 2：大氣壓強與紙包飲品盒
      function drawJuiceBoxScene() {
        const cx = 300;
        const topY = 130;
        const botY = 330;
        const halfW = 75;
        const squeeze = expActed ? 34 : 0; // 吸氣後向內凹陷

        // 飲管
        ctx.strokeStyle = "#f43f5e";
        ctx.lineWidth = 8;
        ctx.beginPath();
        ctx.moveTo(cx, topY);
        ctx.lineTo(cx, 70);
        ctx.lineTo(cx + 45, 50);
        ctx.stroke();

        if (expActed) {
          drawArrow(cx, 115, cx, 65, "#be123c", 3);
          ctx.fillStyle = "#be123c";
          ctx.font = "900 14px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("💨 吸走盒內空氣！", cx - 80, 75);
        }

        // 紙包飲品盒身（吸氣後左右兩側向內凹陷）
        ctx.fillStyle = "#fef08a";
        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(cx - halfW, topY);
        ctx.lineTo(cx + halfW, topY);
        ctx.quadraticCurveTo(cx + halfW - squeeze, (topY + botY) / 2, cx + halfW, botY);
        ctx.lineTo(cx - halfW, botY);
        ctx.quadraticCurveTo(cx - halfW + squeeze, (topY + botY) / 2, cx - halfW, topY);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // 盒內空氣粒子（吸氣前 24 粒，吸氣後只剩 5 粒）
        const insideCount = expActed ? 5 : 24;
        drawParticlesInBox(cx - halfW + squeeze + 8, topY + 15, (halfW - squeeze) * 2 - 16, botY - topY - 30, insideCount, "#9333ea");

        // 盒外空氣粒子與大氣壓強紅色箭頭
        if (showMicroLens) {
          drawParticlesInBox(40, 110, 140, 230, 14, "#64748b");
          drawParticlesInBox(420, 110, 140, 230, 14, "#64748b");

          // 盒外大氣壓力大箭頭
          drawArrow(140, 180, cx - halfW + squeeze - 6, 180, "#e11d48", 5);
          drawArrow(140, 270, cx - halfW + squeeze - 6, 270, "#e11d48", 5);
          drawArrow(460, 180, cx + halfW - squeeze + 6, 180, "#e11d48", 5);
          drawArrow(460, 270, cx + halfW - squeeze + 6, 270, "#e11d48", 5);

          ctx.fillStyle = "#be123c";
          ctx.font = "900 13px sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("盒外大氣壓力大", 110, 155);
          ctx.fillText("盒外大氣壓力大", 490, 155);

          if (!expActed) {
            // 吸氣前盒內向外頂住的箭頭與外面平衡
            drawArrow(cx - 20, 225, cx - halfW + 8, 225, "#0284c7", 4);
            drawArrow(cx + 20, 225, cx + halfW - 8, 225, "#0284c7", 4);
          }

          ctx.fillStyle = "#4a3728";
          ctx.font = "900 14px sans-serif";
          ctx.fillText(
            expActed
              ? "🔍 吸氣後：盒內空氣粒子減少（氣壓變小），盒外大氣壓力把盒壓扁！"
              : "🔍 吸氣前：盒內與盒外的空氣壓力互相平衡，紙盒不會扁。",
            cx,
            395
          );
        }
      }

      // 場景 3：溫度與空氣流動（海風形成）
      function drawSeaBreezeScene() {
        // 天空
        ctx.fillStyle = "#f0f9ff";
        ctx.fillRect(0, 0, canvas.width, 290);

        // 左側：海洋
        ctx.fillStyle = "#38bdf8";
        ctx.fillRect(0, 290, 300, 130);
        ctx.fillStyle = "#fff";
        ctx.font = "900 16px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("🌊 海洋（較涼）", 150, 345);

        // 右側：陸地沙灘
        ctx.fillStyle = "#fde047";
        ctx.fillRect(300, 290, 300, 130);
        ctx.fillStyle = "#854d0e";
        ctx.fillText("🏖️ 陸地（受熱快）", 450, 345);

        // 太陽
        ctx.fillStyle = expActed ? "#f97316" : "#fde047";
        ctx.beginPath();
        ctx.arc(480, 68, expActed ? 36 : 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#fff";
        ctx.font = "bold 12px sans-serif";
        ctx.fillText(expActed ? "☀️ 猛烈陽光" : "☀️ 太陽", 480, 72);

        if (expActed) {
          // 1. 陸地熱空氣膨脹上升（紅色箭頭）
          drawArrow(450, 270, 450, 125, "#e11d48", 5);
          ctx.fillStyle = "#be123c";
          ctx.font = "900 14px sans-serif";
          ctx.fillText("① 空氣受熱膨脹 ➔ ② 熱空氣上升", 450, 105);

          // 2. 海面冷空氣流向陸地補充（藍色海風箭頭）
          drawArrow(160, 250, 380, 250, "#0284c7", 6);
          ctx.fillStyle = "#0369a1";
          ctx.fillText("③ 海面冷空氣流向陸地補充（形成海風）", 270, 228);

          // 高空循環虛線箭頭
          drawArrow(410, 120, 190, 120, "#94a3b8", 3);
          drawArrow(150, 135, 150, 235, "#0284c7", 3);
        }

        if (showMicroLens) {
          // 海面較密集的冷空氣粒子（藍色）
          drawParticlesInBox(60, 180, 160, 100, 16, "#0284c7");
          // 陸地受熱上升較稀疏的熱空氣粒子（紅色）
          drawParticlesInBox(380, expActed ? 110 : 180, 150, 120, 9, "#e11d48");
        }
      }

      // 場景 4A：吸盤掛鈎
      function drawSuctionCupScene() {
        // 牆壁
        ctx.fillStyle = "#cbd5e1";
        ctx.fillRect(140, 50, 40, 320);
        ctx.strokeStyle = "#475569";
        ctx.lineWidth = 3;
        ctx.strokeRect(140, 50, 40, 320);

        // 吸盤
        const cupDepth = expActed ? 18 : 55;
        ctx.fillStyle = "#f472b6";
        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(180, 130);
        ctx.quadraticCurveTo(180 + cupDepth, 210, 180, 290);
        ctx.stroke();

        if (!expActed) {
          drawParticlesInBox(182, 160, 40, 100, 10, "#9333ea");
        }

        if (showMicroLens) {
          drawParticlesInBox(260, 100, 220, 220, 22, "#64748b");
          drawArrow(330, 175, 195 + cupDepth / 2, 175, "#e11d48", 5);
          drawArrow(330, 245, 195 + cupDepth / 2, 245, "#e11d48", 5);
          ctx.fillStyle = "#be123c";
          ctx.font = "900 14px sans-serif";
          ctx.textAlign = "left";
          ctx.fillText("外面的大氣壓強把吸盤壓緊在牆上！", 260, 360);
        }
      }

      // 場景 4B：熱氣球升空
      function drawHotAirBalloonScene() {
        const cx = 300;
        const by = expActed ? 125 : 225;

        // 氣球籃子
        ctx.fillStyle = "#b45309";
        ctx.fillRect(cx - 22, by + 95, 44, 30);

        // 火焰
        if (expActed) {
          ctx.fillStyle = "#f97316";
          ctx.beginPath();
          ctx.arc(cx, by + 72, 14, 0, Math.PI * 2);
          ctx.fill();
          drawArrow(cx, by + 40, cx, by - 45, "#e11d48", 5);
        }

        // 熱氣球球體
        ctx.fillStyle = "rgba(250, 204, 21, 0.35)";
        ctx.strokeStyle = "#4a3728";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.arc(cx, by, 68, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        if (showMicroLens) {
          drawParticlesInBox(cx - 45, by - 45, 90, 90, expActed ? 8 : 18, expActed ? "#e11d48" : "#9333ea");
        }
      }

      // ====== 載入當前實驗與題目介面 ======
      function loadExperimentUI() {
        const item = getCurrentItem();
        expActed = false;
        selectedChoice = null;
        userChain = [];

        expTitleBadge.textContent = item.expTitle;
        actionExpBtn.textContent = item.actionBtnLabel;
        qTitleText.textContent = item.question;
        ghostDraftPill.classList.remove("show");

        // 單元 4 顯示自訂題目輸入框
        customSetupBox.classList.toggle("show", currentLabKey === "daily");

        // 切換實驗情境按鈕（若該單元有多個子實驗）
        switchSubTopicBtn.style.display = LAB_DATA[currentLabKey].length > 1 ? "inline-flex" : "none";

        renderOptionsUI(item);

        statusPill.className = "status-pill status-wait";
        statusPill.textContent = "⏳ 等待完成實驗並檢查答案";
        feedbackBody.innerHTML = `
          <p style="font-size:0.9rem; color:var(--ink-muted); font-weight:700;">
            1. 先按上方粉紅色「<strong>${item.actionBtnLabel}</strong>」。<br/>
            2. 觀察畫布中的<strong>空氣粒子與箭頭</strong>，再揀答案！
          </p>
        `;

        setCharacterDialogue(
          "default_chii",
          "小八貓",
          "speaker-chii",
          `先按「<strong>${item.actionBtnLabel}</strong>」做實驗，再答問題換獎勵卡吧！`
        );
      }

      function renderOptionsUI(item) {
        optionsList.innerHTML = "";

        if (item.type === "chain") {
          qStepTag.textContent = "因果流程排序（依序點擊 3 個步驟）";
          chainSlotsBox.style.display = "flex";
          updateChainSlotsUI(item);

          item.options.forEach((optText, idx) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "option-btn";
            btn.textContent = `🔹 ${optText}`;
            btn.addEventListener("click", () => {
              if (!userChain.includes(idx) && userChain.length < 3) {
                userChain.push(idx);
                btn.classList.add("selected");
                updateChainSlotsUI(item);
              }
            });
            optionsList.appendChild(btn);
          });
        } else {
          qStepTag.textContent = "選擇正確的科學解釋";
          chainSlotsBox.style.display = "none";

          item.options.forEach((optText, idx) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "option-btn";
            btn.textContent = optText;
            btn.addEventListener("click", () => {
              selectedChoice = idx;
              document.querySelectorAll("#optionsList .option-btn").forEach((b, bIdx) => {
                b.classList.remove("wrong-choice");
                b.classList.toggle("selected", bIdx === idx);
              });
            });
            optionsList.appendChild(btn);
          });
        }
      }

      function updateChainSlotsUI(item) {
        for (let i = 0; i < 3; i++) {
          if (userChain[i] !== undefined) {
            slotEls[i].textContent = `${i + 1}. ${item.options[userChain[i]]}`;
          } else {
            slotEls[i].textContent = `${i + 1}. (請點擊步驟)`;
          }
        }
      }

      clearSlotsBtn.addEventListener("click", () => {
        userChain = [];
        const item = getCurrentItem();
        updateChainSlotsUI(item);
        document.querySelectorAll("#optionsList .option-btn").forEach((b) => b.classList.remove("selected"));
      });

      // ====== 檢查答案與蘇格拉底漸進引導 ======
      checkAnswerBtn.addEventListener("click", () => {
        const item = getCurrentItem();
        expActed = true; // 自動觸發實驗狀態方便學生對照

        if (item.type === "chain") {
          if (userChain.length < 3) {
            alert("請先點擊選齊 3 個步驟排出因果次序！");
            return;
          }
          lastDraftStr = userChain.map((i) => item.options[i]).join(" ➔ ");
          ghostDraftPill.textContent = `👻 上次草稿：${lastDraftStr}`;
          ghostDraftPill.classList.add("show");

          const isChainCorrect =
            userChain[0] === item.correctChain[0] &&
            userChain[1] === item.correctChain[1] &&
            userChain[2] === item.correctChain[2];

          if (isChainCorrect) {
            handleCorrectVictory(item.summary);
          } else {
            showSocraticGuidance(item.hint1, item.hint2);
          }
          return;
        }

        // 單選題檢查
        if (selectedChoice === null) {
          alert("請先點選一個答案！");
          return;
        }

        lastDraftStr = item.options[selectedChoice];
        ghostDraftPill.textContent = `👻 上次草稿：${lastDraftStr}`;
        ghostDraftPill.classList.add("show");

        if (selectedChoice === item.correctIdx) {
          handleCorrectVictory(item.summary);
        } else {
          const allBtns = document.querySelectorAll("#optionsList .option-btn");
          if (allBtns[selectedChoice]) {
            allBtns[selectedChoice].classList.add("wrong-choice");
          }
          showSocraticGuidance(item.hint1, item.hint2);
        }
      });

      function handleCorrectVictory(summaryText) {
        stampCount++;
        stampCountEl.textContent = stampCount;
        viewRewardCardBtn.style.display = "inline-flex";

        statusPill.className = "status-pill status-ok";
        statusPill.textContent = "🎉 科學推理完全正確！";

        setCharacterDialogue(
          "happy_usagi",
          "吉伊卡哇 & 兔兔",
          "speaker-usagi",
          `太棒了！${summaryText} 快向老師換取獎勵卡！`
        );

        feedbackBody.innerHTML = `
          <div class="stamp-victory">
            <p style="font-weight:900; color:#15803d; font-size:0.95rem; margin-bottom:8px;">
              ✨ ${summaryText}
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:8px; justify-content:center;">
              <button type="button" class="btn btn-pink" id="openCardAgainBtn">
                🎁 顯示獎勵卡
              </button>
              <button type="button" class="btn btn-yellow" id="nextExpVictoryBtn">
                🚀 挑戰下一個實驗
              </button>
            </div>
          </div>
        `;

        document.getElementById("openCardAgainBtn").addEventListener("click", () => {
          rewardModal.classList.add("show");
        });

        document.getElementById("nextExpVictoryBtn").addEventListener("click", () => {
          goNextExperiment();
        });

        rewardModal.classList.add("show");
      }

      function showSocraticGuidance(hint1, hint2) {
        showMicroLens = true;
        updateLensUI();

        statusPill.className = "status-pill status-retry";
        statusPill.textContent = "🔍 再想一想！睇下小八貓的漸進提示";

        setCharacterDialogue(
          "thinking_hachi",
          "小八貓",
          "speaker-hachi",
          `已幫你開啟「<strong>✨ 微觀透視鏡</strong>」並保留上次草稿，跟住下面兩步提示觀察一下吧！`
        );

        feedbackBody.innerHTML = `
          <div class="guide-step step-pink">
            <div class="guide-step-title">🐾 蘇格拉底提問 1：觀察微觀粒子</div>
            <p>${hint1}</p>
          </div>

          <div class="guide-step step-yellow">
            <div class="guide-step-title">💡 蘇格拉底提問 2：推論科學原理</div>
            <p>${hint2}</p>
          </div>
        `;
      }

      // ====== 按鈕事件綁定 ======
      function updateLensUI() {
        toggleMicroLensBtn.classList.toggle("active", showMicroLens);
        toggleMicroLensBtn.textContent = `✨ 微觀空氣粒子透視鏡：${showMicroLens ? "開" : "關"}`;
        lensStatusBadge.textContent = showMicroLens
          ? "🟣 透視鏡開啟中（圓點 = 空氣粒子）"
          : "👁️ 一般肉眼模式（看不見空氣）";
      }

      toggleMicroLensBtn.addEventListener("click", () => {
        showMicroLens = !showMicroLens;
        updateLensUI();
      });

      actionExpBtn.addEventListener("click", () => {
        expActed = true;
        setCharacterDialogue(
          "thinking_hachi",
          "小八貓",
          "speaker-hachi",
          "實驗動作完成！快觀察畫布裏的<strong>空氣粒子與箭頭變化</strong>，然後揀出正確答案！"
        );
      });

      resetExpBtn.addEventListener("click", () => {
        expActed = false;
      });

      switchSubTopicBtn.addEventListener("click", () => {
        const list = LAB_DATA[currentLabKey];
        subIdx = (subIdx + 1) % list.length;
        loadExperimentUI();
      });

      function goNextExperiment() {
        const keys = ["space", "pressure", "wind", "daily"];
        const list = LAB_DATA[currentLabKey];
        if (subIdx + 1 < list.length) {
          subIdx++;
        } else {
          const nextKeyIdx = (keys.indexOf(currentLabKey) + 1) % keys.length;
          currentLabKey = keys[nextKeyIdx];
          subIdx = 0;
          labChips.forEach((c) => c.classList.toggle("active", c.dataset.lab === currentLabKey));
        }
        loadExperimentUI();
      }

      labChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          currentLabKey = chip.dataset.lab;
          subIdx = 0;
          labChips.forEach((c) => c.classList.toggle("active", c === chip));
          loadExperimentUI();
        });
      });

      // 自訂日常現象出題
      applyCustomBtn.addEventListener("click", () => {
        const qStr = customQText.value.trim() || "為甚麼用力吸走膠樽內的空氣後，膠樽會向內凹陷？";
        const correctIdx = parseInt(customCorrectPrinciple.value, 10);

        const customItem = {
          id: correctIdx === 2 ? "hot_air_balloon" : "suction_cup",
          expTitle: "✏️ 自訂日常科學現象挑戰",
          actionBtnLabel: "▶️ 觀察微觀粒子模擬",
          question: qStr,
          type: "choice",
          options: [
            "A. 因為裏面空氣減少（氣壓變小），外面的大氣壓強較大把它壓住或壓扁",
            "B. 因為空氣佔有空間及具有重量",
            "C. 因為空氣受熱膨脹，熱空氣變輕上升"
          ],
          correctIdx,
          hint1: "開啟「✨ 微觀透視鏡」，想想這個現象與氣壓差、佔有空間、還是受熱上升有關？",
          hint2: "比較物體內外的空氣粒子數量或溫度變化，就能找出原因！",
          summary: "你成功運用空氣的科學原理解釋日常生活現象！"
        };

        LAB_DATA.daily.unshift(customItem);
        subIdx = 0;
        loadExperimentUI();
      });

      // 啟動實驗室
      loadExperimentUI();
      requestAnimationFrame(renderScienceCanvas);
    })();
  </script>
</body>
</html>
