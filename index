      // ====== 畫布輔助繪圖函式 ======
      function drawParticlesInBox(x, y, w, h, count, color = "#9333ea") {
        if (!showMicroLens) return;
        ctx.save();
        ctx.fillStyle = color;
        for (let i = 0; i < count; i++) {
          const p = particles[i % particles.length];
          const px = x + 12 + ((p.x + animTick * p.vx * 18) % 1 + 1) % 1 * (w - 24);
          const py = y + 12 + ((p.y + animTick * p.vy * 18) % 1 + 1) % 1 * (h - 24);
          ctx.beginPath();
          ctx.arc(px, py, 5.2, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();
      }

      function drawArrow(x1, y1, x2, y2, color, lineWidth = 3.5) {
        const headlen = 10;
        const angle = Math.atan2(y2 - y1, x2 - x1);
        ctx.save();
        ctx.strokeStyle = color;
        ctx.fillStyle = color;
        ctx.lineWidth = lineWidth;
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(x2, y2);
        ctx.lineTo(x2 - headlen * Math.cos(angle - Math.PI / 6), y2 - headlen * Math.sin(angle - Math.PI / 6));
        ctx.lineTo(x2 - headlen * Math.cos(angle + Math.PI / 6), y2 - headlen * Math.sin(angle + Math.PI / 6));
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }

