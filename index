          drawCupWaterScene();
        } else if (item.id === "balloon_balance") {
          drawBalloonBalanceScene();
        } else if (item.id === "juice_box") {
          drawJuiceBoxScene();
        } else if (item.id === "sea_breeze") {
          drawSeaBreezeScene();
        } else if (item.id === "suction_cup") {
          drawSuctionCupScene();
        } else {
          drawHotAirBalloonScene();
        }

        requestAnimationFrame(renderScienceCanvas);
      }

      // 場景 1A：倒轉杯子壓入水中
      function drawCupWaterScene() {
